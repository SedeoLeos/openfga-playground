# ─── Application ────────────────────────────────────────────────────────────
# standalone = single account, SQLite
# saas       = multi-tenant, PostgreSQL
APP_MODE=standalone
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Better Auth ─────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=change-me-at-least-32-chars-random
BETTER_AUTH_URL=http://localhost:3000

# ─── Database ────────────────────────────────────────────────────────────────
# SQLite (standalone mode)
DATABASE_URL=file:./local.db

# PostgreSQL (saas mode) — comment out SQLite line above and use this
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/openfga_playground

# ─── OAuth Providers ─────────────────────────────────────────────────────────
# Google: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set to "true" to show the Google OAuth button on the login page
NEXT_PUBLIC_GOOGLE_ENABLED=false

# GitHub: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Set to "true" to show the GitHub OAuth button on the login page
NEXT_PUBLIC_GITHUB_ENABLED=false

# ─── OpenFGA (default server — standalone mode) ──────────────────────────────
OPENFGA_API_URL=http://localhost:8080
OPENFGA_API_TOKEN=
OPENFGA_STORE_ID=

# ─── Email (optional — for password reset) ───────────────────────────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@example.com
